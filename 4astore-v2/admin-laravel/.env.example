APP_NAME="4AStore Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# Same MySQL DB as the Node API
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=four_a_store
DB_USERNAME=root
DB_PASSWORD=

# MUST match the Node API JWT_SECRET so tokens verify across services
JWT_SECRET=dev-4astore-super-secret-change-in-prod

# CORS for the React admin UI
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DRIVER=file
