# =============================================================================
# subdomain-provision.sh ke liye config.
#
# Server pe copy karo:   cp subdomain-provision.env.example subdomain-provision.env
# Phir asli values bharo. Ye file git me kabhi commit mat karo (secrets).
#   chmod 600 subdomain-provision.env
# =============================================================================

# ---- Cloudflare ----
# API Token (NOT the global key). Permission: Zone > DNS > Edit, for zone 4astore.com.
# Banane ke liye: Cloudflare dashboard > My Profile > API Tokens > Create Token
CF_API_TOKEN="paste-cloudflare-api-token-here"

# Zone ID of 4astore.com (Cloudflare > 4astore.com > Overview > right side "Zone ID").
CF_ZONE_ID="paste-zone-id-here"

# Root domain (zone naam). Subdomain isi ke neeche banega: <sub>.4astore.com
ROOT_DOMAIN="4astore.com"

# Server ka PUBLIC IP (jahan A-record point karega). EC2 ka elastic/public IP.
SERVER_IP="paste-server-public-ip-here"

# Cloudflare proxy (orange cloud) on rakhein? true = proxied (SSL + CDN), false = DNS only.
CF_PROXIED="true"

# ---- Server paths ----
# Jahan har subdomain ka folder banega.
SITES_ROOT="/var/www/sites"

# Apache vhost config kahan likhein (Amazon Linux: /etc/httpd/conf.d).
VHOST_DIR="/etc/httpd/conf.d"

# Apache service naam (Amazon Linux = httpd, Ubuntu = apache2).
APACHE_SERVICE="httpd"

# Jिस group se Apache files serve karta hai (Amazon Linux = apache, Ubuntu = www-data).
WEB_GROUP="apache"

# ---- SFTP ----
# Sabhi SFTP users isi group me honge (sshd_config isi group ko chroot karega).
SFTP_GROUP="sftpusers"
