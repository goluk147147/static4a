# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (React web, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- MySQL (shared with Laravel admin) ----
# Prisma connection string.
# connection_limit / pool_timeout make the pool explicit instead of Prisma's
# host-core default, so bursty traffic (staff/rider pollers + app-launch
# fetches) does not stall waiting for a free connection. Tune connection_limit
# to the DB server's max_connections on the live box.
DATABASE_URL="mysql://root:@localhost:3306/four_a_store?connection_limit=10&pool_timeout=20"

# ---- JWT / life-long login ----
# Use one strong secret; Laravel must use the same for cross-verification.
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m
# ~1 year refresh token for permanent login
REFRESH_TOKEN_TTL_DAYS=365

# ---- Store defaults (fallbacks; real values live in `settings` table) ----
STORE_LAT=24.580164
STORE_LNG=84.114194
SERVICEABLE_PINCODE=824301

# ---- OSRM (free routing, no key) ----
OSRM_URL=https://router.project-osrm.org

# ---- Mail (Nodemailer) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=online4astore@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="4A Store <online4astore@gmail.com>"

# ---- Firebase Cloud Messaging (push) ----
# Path to service account JSON, or leave blank to disable push in dev.
FCM_SERVICE_ACCOUNT=./firebase-service-account.json

# ---- Google Sign-In (social login) ----
# The two "aud" (audience) values the server accepts when verifying a Google
# ID token at POST /api/users/social-login. The web client sends tokens minted
# for GOOGLE_WEB_CLIENT_ID; the Android app sends tokens minted for
# GOOGLE_ANDROID_CLIENT_ID. Google client IDs are NOT secrets — these defaults
# are also hard-coded in src/routes/users.ts; set these only to override.
GOOGLE_WEB_CLIENT_ID=707085023016-etp7au34rg3cd5eks6cdu0cs0vkj1svn.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=707085023016-pc4gc5271kquti6recqo9juor3p44dn9.apps.googleusercontent.com
