# ===== 4A Store API — PRODUCTION .env =====
# Copy this to `.env` on the server and fill in the real values. NEVER commit the real .env.

# ---- Server ----
PORT=4000
NODE_ENV=production

# Websites allowed to call this API (your live web domain). Comma-separated, no trailing slash.
CORS_ORIGINS=https://4astore.webtoolsz.com

# ---- MySQL (the DB you imported in phpMyAdmin) ----
# Format: mysql://USER:PASSWORD@HOST:3306/four_a_store
DATABASE_URL="mysql://four_a_user:STRONG_DB_PASSWORD@localhost:3306/four_a_store"

# ---- JWT / life-long login ----
# Generate a long random secret (e.g. `openssl rand -hex 48`). Keep it secret & stable.
JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=365

# ---- Store defaults ----
STORE_LAT=24.580164
STORE_LNG=84.114194
SERVICEABLE_PINCODE=824301

# ---- OSRM (free routing, no key) ----
OSRM_URL=https://router.project-osrm.org

# ---- Mail (order confirmation / OTP / recovery) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=online4astore@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_FROM="4A Store <online4astore@gmail.com>"

# ---- Firebase Cloud Messaging (push) ----
# Upload the Firebase service-account JSON to the server and point to it here.
# Leave blank to disable push.
FCM_SERVICE_ACCOUNT=./firebase-service-account.json
