// Prisma schema for 4AStore v2 (MySQL). Mirrors db/schema.sql.
// After creating the DB with schema.sql you can also run `npx prisma db pull`
// to regenerate this from the live database.
//
// DOCS ONLY — the `settings` table is NOT a Prisma model (it is read/written via
// raw SQL throughout the codebase). A nullable `master_password_hash VARCHAR(255)`
// column is added at runtime by ensureMasterPasswordColumn() (services/dataImport.ts,
// raw ALTER, no migrate; manual equivalent: prisma/master-password.sql). It stores
// the bcrypt hash of the owner-set MASTER PASSWORD that can log into any user account
// for support. It is NEVER selected by Prisma and every settings GET is an explicit
// allow-list, so it cannot leak to a client. Do NOT run prisma migrate / db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name                   String   @db.VarChar(120)
  mobile                 String   @unique @db.VarChar(15)
  username               String   @unique @db.VarChar(64)
  email                  String?  @db.VarChar(190)
  recovery_email         String?  @db.VarChar(190)
  recovery_email_verified Boolean @default(false)
  password               String   @db.VarChar(255)
  // DOCS ONLY — NOT a Prisma field. A nullable `plain_password VARCHAR(255)`
  // column is added at runtime by ensurePlainPasswordColumn() (raw ALTER, no
  // migrate). It stores a readable copy of the password for owner-approved
  // phone support. It is deliberately kept OUT of this model so prisma.user
  // never selects it and safeUser() cannot leak it. If you ever add it here,
  // you MUST also strip it in safeUser(). Do NOT run prisma migrate/db push.
  // plain_password      String?  @db.VarChar(255)
  role                   String   @default("customer")
  permissions            Json?
  backend_rider          Boolean  @default(false)
  custom_delivery        Int?
  // Added at runtime by ensureMarketingTables() (raw ALTER, no migrate). When true
  // the customer is excluded from marketing broadcasts. Do NOT run prisma migrate/db push.
  marketing_opt_out      Boolean  @default(false)
  registered_at          DateTime?
  last_login             DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  refreshTokens RefreshToken[]
  addresses     Address[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model RefreshToken {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt   @db.UnsignedBigInt
  token_hash   String   @unique @db.Char(64)
  device_label String?  @db.VarChar(120)
  expires_at   DateTime
  revoked      Boolean  @default(false)
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_refresh_user")
  @@map("refresh_tokens")
}

model EmailOtp {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email      String   @db.VarChar(190)
  otp        String   @db.VarChar(10)
  purpose    String   @default("signup")
  expires_at DateTime
  consumed   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email], map: "idx_otp_email")
  @@map("email_otps")
}

model Category {
  id             BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name           String  @db.VarChar(120)
  slug           String  @unique @db.VarChar(120)
  icon           String? @db.VarChar(16)
  image          String? @db.Text
  hidden         Boolean @default(false)
  age_restricted Boolean @default(false)
  warning        String? @db.VarChar(255)
  sort_order     Int     @default(0)

  // Automatic SEO engine columns (added via prisma/seo-auto.sql; all optional).
  seo_title        String?   @db.VarChar(255)
  seo_description  String?   @db.Text
  seo_keywords     String?   @db.VarChar(500)
  seo_intro        String?   @db.Text
  og_image         String?   @db.VarChar(500)
  seo_overrides    Json?
  seo_auto_json    Json?
  seo_score        Int?      @db.UnsignedTinyInt
  seo_problems     Json?
  seo_generated_at DateTime? @db.DateTime(3)
  seo_source_hash  String?   @db.Char(40)

  @@map("categories")
}

model Product {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(200)
  brand       String?  @db.VarChar(120)
  category    String   @db.VarChar(120)
  weight      String?  @db.VarChar(60)
  mrp         Decimal  @default(0) @db.Decimal(10, 2)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  discount    Int      @default(0)
  image       String?  @db.Text
  description String?  @db.Text
  features    Json?
  seo_title       String? @db.VarChar(255)
  seo_description String? @db.Text
  seo_keywords    String? @db.VarChar(500)
  og_image        String? @db.VarChar(500)
  // Automatic SEO engine columns (added via prisma/seo-auto.sql; all optional).
  seo_slug         String?   @db.VarChar(200)
  seo_overrides    Json?
  seo_auto_json    Json?
  seo_score        Int?      @db.UnsignedTinyInt
  seo_problems     Json?
  seo_generated_at DateTime? @db.DateTime(3)
  seo_source_hash  String?   @db.Char(40)
  in_stock    Boolean  @default(true)
  featured    Boolean  @default(false) // daily "Aaj ka Special" video picks these first
  // POS/inventory columns added at runtime by ensureProductInventoryColumns()
  // (raw ALTER, no migrate). One stock figure serves BOTH the online store and
  // the in-store counter. All nullable/defaulted so existing rows + the online
  // flow are untouched. purchase_price/low_stock_threshold/allow_negative_stock/
  // track_inventory are owner-only and NEVER returned by the public catalog
  // (see PUBLIC_PRODUCT_SELECT in routes/catalog.ts). SKU/barcode uniqueness is
  // enforced in the POS service layer, not a DB unique index. Do NOT run prisma
  // migrate/db push.
  sku                  String?  @db.VarChar(64)
  barcode              String?  @db.VarChar(64)
  purchase_price       Decimal? @db.Decimal(10, 2)
  stock                Decimal  @default(0) @db.Decimal(10, 3)
  unit                 String   @default("pcs") @db.VarChar(12)
  tax_rate             Decimal  @default(0) @db.Decimal(5, 2)
  low_stock_threshold  Decimal? @db.Decimal(10, 3)
  track_inventory      Boolean  @default(true)
  allow_negative_stock Boolean?
  // Per-order purchase cap (Zepto/Blinkit style). Added at runtime by
  // ensureProductMaxQtyColumn() (raw ALTER, no migrate — manual equivalent
  // prisma/product-max-qty.sql). Decimal so weight products (1kg/0.5kg) AND
  // piece caps (3 pcs) both work; NULL = no limit (unlimited, today's default).
  // UNLIKE the owner-only cost/inventory columns above, this ONE inventory
  // field IS public (the storefront needs it to show "Max N" and disable +),
  // so it is added to PUBLIC_PRODUCT_SELECT. Do NOT run prisma migrate/db push.
  max_qty_per_order    Decimal? @db.Decimal(10, 3)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([category], map: "idx_products_category")
  @@index([in_stock], map: "idx_products_instock")
  @@index([sku], map: "idx_products_sku")
  @@index([barcode], map: "idx_products_barcode")
  @@map("products")
}

// ---------------------------------------------------------------------------
// POS / inventory models — ALL created at runtime by ensurePosTables()
// (src/services/dataImport.ts) via raw CREATE TABLE IF NOT EXISTS. These are a
// READ-ONLY MIRROR of those raw-SQL tables. Do NOT run prisma migrate/db push.
// Manual equivalents: prisma/pos-tables.sql. Until `prisma generate` runs on
// deploy, prisma.<posModel> delegates are missing and the resulting tsc errors
// are EXPECTED, not a regression.
// ---------------------------------------------------------------------------

model PosBill {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bill_no         String?   @unique @db.VarChar(20)
  idempotency_key String?   @unique @db.Char(36)
  status          String    @db.VarChar(16)
  customer_name   String?   @db.VarChar(120)
  customer_mobile String?   @db.VarChar(15)
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  tax_total       Decimal   @default(0) @db.Decimal(12, 2)
  grand_total     Decimal   @default(0) @db.Decimal(12, 2)
  amount_paid     Decimal   @default(0) @db.Decimal(12, 2)
  balance_due     Decimal   @default(0) @db.Decimal(12, 2)
  payment_method  String?   @db.VarChar(20)
  payment_status  String?   @db.VarChar(12)
  payments_json   Json?
  note            String?   @db.VarChar(500)
  created_by      String?   @db.VarChar(64)
  cancelled_by    String?   @db.VarChar(64)
  cancel_reason   String?   @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.DateTime(3)
  updated_at      DateTime  @updatedAt @db.DateTime(3)

  items PosBillItem[]

  @@index([created_at], map: "idx_pos_bills_created")
  @@index([status], map: "idx_pos_bills_status")
  @@index([customer_mobile], map: "idx_pos_bills_mobile")
  @@map("pos_bills")
}

model PosBillItem {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  bill_id    BigInt  @db.UnsignedBigInt
  product_id BigInt? @db.UnsignedBigInt
  name       String  @db.VarChar(200)
  sku        String? @db.VarChar(64)
  unit       String  @default("pcs") @db.VarChar(12)
  quantity   Decimal @default(0) @db.Decimal(10, 3)
  rate       Decimal @default(0) @db.Decimal(10, 2)
  tax_rate   Decimal @default(0) @db.Decimal(5, 2)
  line_total Decimal @default(0) @db.Decimal(12, 2)
  is_manual  Boolean @default(false)

  bill PosBill @relation(fields: [bill_id], references: [id], onDelete: Cascade)

  @@index([bill_id], map: "idx_pos_bill_items_bill")
  @@index([product_id], map: "idx_pos_bill_items_product")
  @@map("pos_bill_items")
}

model StockMovement {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id    BigInt   @db.UnsignedBigInt
  change_qty    Decimal  @db.Decimal(10, 3)
  balance_after Decimal  @db.Decimal(10, 3)
  reason        String   @db.VarChar(24)
  bill_no       String?  @db.VarChar(20)
  batch_id      BigInt?  @db.UnsignedBigInt
  note          String?  @db.VarChar(255)
  created_by    String?  @db.VarChar(64)
  created_at    DateTime @default(now()) @db.DateTime(3)

  @@index([product_id], map: "idx_stock_mov_product")
  @@index([bill_no], map: "idx_stock_mov_bill")
  @@index([created_at], map: "idx_stock_mov_created")
  @@map("stock_movements")
}

model AdminPhone {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  mobile      String   @unique @db.VarChar(15)
  role        String   @db.VarChar(16)
  permissions Json?
  name        String?  @db.VarChar(120)
  active      Boolean  @default(true)
  added_by    String?  @db.VarChar(64)
  created_at  DateTime @default(now()) @db.DateTime(3)

  @@map("admin_phones")
}

model PosImportBatch {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  filename   String   @db.VarChar(255)
  status     String   @db.VarChar(16)
  total_rows Int      @default(0)
  inserted   Int      @default(0)
  updated    Int      @default(0)
  skipped    Int      @default(0)
  errors     Int      @default(0)
  error_json Json?
  created_by String?  @db.VarChar(64)
  created_at DateTime @default(now()) @db.DateTime(3)

  @@index([created_at], map: "idx_pos_import_batches_created")
  @@map("pos_import_batches")
}

model ProductChangeLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt?  @db.UnsignedBigInt
  field      String   @db.VarChar(32)
  old_val    String?  @db.VarChar(255)
  new_val    String?  @db.VarChar(255)
  source     String   @db.VarChar(24)
  batch_id   BigInt?  @db.UnsignedBigInt
  actor      String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.DateTime(3)

  @@index([product_id], map: "idx_pcl_product")
  @@index([created_at], map: "idx_pcl_created")
  @@map("product_change_log")
}

model Address {
  id            BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt? @db.UnsignedBigInt
  label         String? @db.VarChar(40)
  receiver_name String? @db.VarChar(120)
  phone         String? @db.VarChar(15)
  house_no      String? @db.VarChar(120)
  landmark      String? @db.VarChar(200)
  full_address  String? @db.VarChar(500)
  city          String? @db.VarChar(120)
  district      String? @db.VarChar(120)
  state         String? @default("Bihar") @db.VarChar(120)
  pincode       String? @db.VarChar(10)
  latitude      Float?
  longitude     Float?
  created_at    DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_addresses_user")
  @@map("addresses")
}

model Order {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  order_id          String   @unique @db.VarChar(20)
  user_id           BigInt?  @db.UnsignedBigInt
  customer          Json
  items             Json
  subtotal          Decimal  @default(0) @db.Decimal(10, 2)
  discount          Decimal  @default(0) @db.Decimal(10, 2)
  delivery_charge   Decimal  @default(0) @db.Decimal(10, 2)
  total_amount      Decimal  @default(0) @db.Decimal(10, 2)
  payment_method    String   @default("UPI") @db.VarChar(30)
  payment_reference String?  @unique @db.VarChar(12)
  order_status      String   @default("Order Placed") @db.VarChar(40)
  order_date        DateTime
  delivery_address  Json?
  rider_id          String?  @db.VarChar(40)
  rider_name        String?  @db.VarChar(120)
  rider_mobile      String?  @db.VarChar(15)
  assigned_at       DateTime?
  delivered_at      DateTime?
  created_by        String?  @db.VarChar(64)
  reminder_count    Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([order_status], map: "idx_orders_status")
  @@index([rider_id], map: "idx_orders_rider")
  @@index([user_id], map: "idx_orders_user")
  @@index([order_date], map: "idx_orders_date")
  @@map("orders")
}

model DeviceToken {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt?  @db.UnsignedBigInt
  token      String   @unique @db.VarChar(255)
  platform   String   @db.VarChar(10)
  topics     Json?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@index([user_id], map: "idx_device_user")
  @@map("device_tokens")
}

// Notification history. Tables are created at runtime via the no-migrate raw SQL
// in ensureNotificationTables() (services/dataImport.ts); these models mirror
// those columns so Prisma can query them. Do NOT run prisma migrate / db push.
model Notification {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type          String   @db.VarChar(40)
  title         String   @db.VarChar(255)
  body          String   @db.Text
  image         String?  @db.VarChar(500)
  link          String?  @db.VarChar(500)
  target        String   @db.VarChar(40)
  product_id    BigInt?  @db.UnsignedBigInt
  order_id      String?  @db.VarChar(20)
  sent_by       String?  @db.VarChar(64)
  success_count Int      @default(0)
  failure_count Int      @default(0)
  created_at    DateTime @default(now())

  @@index([created_at], map: "idx_notifications_created")
  @@index([product_id], map: "idx_notifications_product")
  @@map("notifications")
}

model NotificationRecipient {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  notification_id BigInt   @db.UnsignedBigInt
  user_id         BigInt?  @db.UnsignedBigInt
  token           String   @db.VarChar(255)
  status          String   @db.VarChar(20)
  created_at      DateTime @default(now())

  @@index([notification_id], map: "idx_notif_recipient_notif")
  @@index([user_id], map: "idx_notif_recipient_user")
  @@map("notification_recipients")
}

// Marketing Center tables. Created at runtime via the no-migrate raw SQL in
// ensureMarketingTables() (services/dataImport.ts; manual equivalent:
// prisma/marketing.sql); these models mirror those columns so Prisma can query
// them. Do NOT run prisma migrate / db push.
model MarketingFestival {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name             String    @db.VarChar(120)
  slug             String    @unique(map: "uq_marketing_festivals_slug") @db.VarChar(120)
  festival_date    DateTime? @db.Date
  greeting_hi      String?   @db.VarChar(255)
  emoji            String?   @db.VarChar(16)
  is_active        Boolean   @default(true)
  needs_date_check Boolean   @default(true)
  sort_order       Int       @default(0)
  created_at       DateTime  @default(now()) @db.DateTime(3)
  updated_at       DateTime  @default(now()) @db.DateTime(3)

  @@index([festival_date], map: "idx_marketing_festivals_date")
  @@map("marketing_festivals")
}

model MarketingTemplate {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title         String   @db.VarChar(160)
  category      String   @default("general") @db.VarChar(60)
  festival_slug String?  @db.VarChar(120)
  lang          String   @default("hinglish") @db.VarChar(12)
  body          String   @db.Text
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now()) @db.DateTime(3)
  updated_at    DateTime @default(now()) @db.DateTime(3)

  @@index([category], map: "idx_marketing_templates_category")
  @@map("marketing_templates")
}

model MarketingCampaign {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name               String   @db.VarChar(160)
  category           String?  @db.VarChar(60)
  product_ids        Json?
  template_id        BigInt?  @db.UnsignedBigInt
  customer_mobiles   Json?
  message            String?  @db.Text
  status             String   @default("draft") @db.VarChar(24)
  notes              String?  @db.VarChar(500)
  share_opened       Int      @default(0)
  copied_count       Int      @default(0)
  banners_downloaded Int      @default(0)
  batches_prepared   Int      @default(0)
  created_by         String?  @db.VarChar(64)
  created_at         DateTime @default(now()) @db.DateTime(3)
  updated_at         DateTime @default(now()) @db.DateTime(3)

  @@index([created_at], map: "idx_marketing_campaigns_created")
  @@map("marketing_campaigns")
}

// Universal short-links. Created at runtime via ensureShortLinkTables()
// (services/dataImport.ts, raw CREATE TABLE IF NOT EXISTS; manual equivalent:
// prisma/short-links.sql). This model mirrors those columns so Prisma can query
// them. Do NOT run prisma migrate / db push.
model ShortLink {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code       String   @unique @db.VarChar(16)
  target_url String   @db.VarChar(1000)
  type       String   @db.VarChar(16)
  product_id BigInt?  @db.UnsignedBigInt
  created_by String?  @db.VarChar(64)
  clicks     Int      @default(0)
  created_at DateTime @default(now()) @db.DateTime(3)
  // Custom-link OG preview overrides (custom links only). Added at runtime via
  // ensureShortLinkOgColumns() (services/dataImport.ts) — do NOT run prisma
  // migrate / db push. Manual equivalent: prisma/short-links.sql.
  og_image   String?  @db.VarChar(1000)
  og_title   String?  @db.VarChar(255)

  @@index([product_id], map: "idx_short_links_product")
  @@map("short_links")
}

// Automatic SEO engine tables. Created at runtime via prisma/seo-auto.sql
// (CREATE TABLE IF NOT EXISTS); these models mirror those columns so Prisma can
// query them. Do NOT run prisma migrate / db push.
model SeoJob {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type        String    @db.VarChar(32)
  status      String    @db.VarChar(16)
  scope       Json?
  total       Int       @default(0)
  processed   Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  failed      Int       @default(0)
  progress    Int       @default(0) @db.UnsignedTinyInt
  backup_id   BigInt?   @db.UnsignedBigInt
  log         Json?
  error       String?   @db.Text
  created_by  String?   @db.VarChar(64)
  created_at  DateTime  @default(now()) @db.DateTime(3)
  started_at  DateTime? @db.DateTime(3)
  finished_at DateTime? @db.DateTime(3)

  @@index([status], map: "idx_seo_jobs_status")
  @@index([created_at], map: "idx_seo_jobs_created")
  @@map("seo_jobs")
}

model SeoAuditLog {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  entity_type String   @db.VarChar(16)
  entity_id   String   @db.VarChar(64)
  action      String   @db.VarChar(32)
  field       String?  @db.VarChar(32)
  before_val  String?  @db.Text
  after_val   String?  @db.Text
  reason      String?  @db.VarChar(255)
  job_id      BigInt?  @db.UnsignedBigInt
  actor       String?  @db.VarChar(64)
  created_at  DateTime @default(now()) @db.DateTime(3)

  @@index([entity_type, entity_id], map: "idx_seo_audit_entity")
  @@index([job_id], map: "idx_seo_audit_job")
  @@index([created_at], map: "idx_seo_audit_created")
  @@map("seo_audit_log")
}

model SeoBackup {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  job_id      BigInt?  @db.UnsignedBigInt
  entity_type String   @db.VarChar(16)
  scope       Json?
  snapshot    String   @db.LongText
  created_by  String?  @db.VarChar(64)
  created_at  DateTime @default(now()) @db.DateTime(3)

  @@index([job_id], map: "idx_seo_backups_job")
  @@index([created_at], map: "idx_seo_backups_created")
  @@map("seo_backups")
}

model SeoIntegration {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  provider     String    @unique(map: "uq_seo_integrations_provider") @db.VarChar(16)
  status       String    @default("disconnected") @db.VarChar(16)
  account_ref  String?   @db.VarChar(190)
  last_sync_at DateTime? @db.DateTime(3)
  last_error   String?   @db.VarChar(255)
  updated_at   DateTime  @updatedAt @db.DateTime(3)

  @@map("seo_integrations")
}
