# Base URL of the Node API. In dev, leave as /api (Vite proxies to :4000).
VITE_API_BASE=/api

# ---- Google Sign-In (social login) ----
# The WEB OAuth client ID. Loaded by Google Identity Services at runtime.
# Leave empty to disable the Google button (it then shows a "setup pending" toast).
VITE_GOOGLE_CLIENT_ID=707085023016-etp7au34rg3cd5eks6cdu0cs0vkj1svn.apps.googleusercontent.com
