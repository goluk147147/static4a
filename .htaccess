RewriteEngine On

# SEO files must always be served directly, never rewritten to the homepage.
RewriteRule ^(?:robots\.txt|sitemap\.xml)$ - [END]

# Temporary mode: domain forwarding is handled by the hosting panel.
# Do not add a reverse redirect here until 4astore.com serves this folder.

# Public APK endpoint: /download and /download.html both download the APK.
RewriteRule ^download(?:\.html)?/?$ 4AStore.apk [L]

# Serve existing files and directories directly. This keeps robots.txt,
# sitemap.xml, assets, APIs, and legal HTML pages reachable by crawlers.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URLs: /products -> /products.html. Query strings are preserved.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Prevent stale HTML, JS, CSS, and JSON after deployments.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^4AStore\.apk$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=4AStore.apk"
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

